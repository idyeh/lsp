# Installed by deploy/setup-server.sh. Run once a day by the matching .timer.
[Unit]
Description=Back up the Lab Seminar Planner database

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@APP_DIR@/deploy/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE_DIR@
