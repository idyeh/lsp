# Installed by deploy/setup-server.sh, which fills in the values that differ per server.
[Unit]
Description=Lab Seminar Planner
After=network.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@APP_DIR@
# systemd reads this as root before dropping privileges, so the file can stay root-only (mode 600).
EnvironmentFile=@ENV_FILE@
ExecStart=@APP_DIR@/.venv/bin/python -m uvicorn app.main:create_app --factory --host ${LSP_BIND_HOST} --port ${LSP_BIND_PORT}
Restart=on-failure
RestartSec=3
UMask=0077

# The code is read-only for the service; it may write only its data directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@STATE_DIR@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
